params {
    samples = "${projectDir}/tests/samples_variant_discovery.yaml"
    input = null
    references = "${projectDir}/../conf/references.yaml"
    thresholds = "${projectDir}/../conf/thresholds.yaml"
    outdir = 'tests/fixtures/banked_stage3'
    ref_data_root = System.getenv('NXF_REF_DATA_ROOT') ?: "${projectDir}/../assets/references"
    ref_dir = System.getenv('NXF_REF_DATA_ROOT') ?: "${projectDir}/../assets/references"
    tmp_dir = '/scratch/tmp'
    work_root = '/scratch/nextflow_work'
    stage3_snv_indel_cpus = null
    stage3_cpus = null
    refs = [
        reference_genome  : '/opt/reference/reference/GRCh38_full_analysis_set_plus_decoy_hla.fa',
        capture_wes_bed   : '/opt/reference/beds/OncoPanel_v4.2_Master_hs38DH.bed',
        onco_target_bed   : '/opt/reference/beds/OncoPanel_v4.2_Master_hs38DH.bed',
        mane_transcripts  : "${projectDir}/tests/schemas/mane_priority_stub.bed",
        stage3_vcf_schema : "${projectDir}/tests/schemas/v4.2_Production_Schema.json"
    ]
}

process {
    errorStrategy = 'finish'

    withLabel: 'process_low' {
        cpus = 4
        memory = 8.GB
        time = 2.h
    }

    withLabel: 'process_medium' {
        cpus = 12
        memory = 24.GB
        time = 6.h
    }

    withLabel: 'variant_heavy' {
        cpus = { 12 * task.attempt }
        memory = { 32.GB * task.attempt }
        time = { 12.h * task.attempt }
        maxRetries = 2
        errorStrategy = { task.exitStatus in [137, 140] ? 'retry' : 'finish' }
    }
}

docker.enabled = false
apptainer.enabled = false

profiles {
    dev_fast {
        process {
            withLabel: 'process_low' {
                cpus = 1
                memory = 2.GB
                time = 1.h
            }
            withLabel: 'process_medium' {
                cpus = 2
                memory = 4.GB
                time = 2.h
            }
            withLabel: 'variant_heavy' {
                cpus = 2
                memory = 4.GB
                time = 2.h
            }
        }
    }

    docker {
        docker {
            enabled = true
            runOptions = "-v \"${params.ref_dir}:/opt/reference:ro\" -v \"${params.tmp_dir}:/tmp\" --rm"
        }
        workDir = params.work_root
        process {
            container = 'genvar-core:2.0.0'
        }
    }

    apptainer {
        apptainer {
            enabled = true
            autoMounts = true
        }
        workDir = params.work_root
        process {
            container = 'file://containers/wes-onco-core.sif'
        }
    }
}
