params {
    samples = "${projectDir}/tests/samples_variant_discovery.yaml"
    input = null
    references = "${projectDir}/../control_plane/references.yaml"
    thresholds = "${projectDir}/../control_plane/thresholds.yaml"
    infrastructure = "${projectDir}/../control_plane/infrastructure.yaml"
    outdir = 'tests/banked_stage3'
    ref_data_root = System.getenv('NXF_REF_DATA_ROOT') ?: '/media/jmk/Extreme Pro/pipeline_references'
    ref_dir = System.getenv('NXF_REF_DATA_ROOT') ?: '/media/jmk/Extreme Pro/pipeline_references'
    tmp_dir = '/scratch/tmp'
    work_root = '/scratch/nextflow_work'

    // Stage 3 infrastructure policy
    // - If unset, profile is selected from infrastructure.yaml policy.
    // - If set via CLI, this value overrides policy resolution.
    infrastructure_profile = null

    // Branch-specific overrides (highest precedence, optional)
    stage3_snv_indel_cpus = null
    stage3_structural_variants_cpus = null
    stage3_sv_cpus = null
    stage3_cnv_cpus = null
    stage3_str_cpus = null
    stage3_trisomy_cpus = null
    stage3_homologous_cpus = null
    stage3_cpus = null

    // Effective defaults injected from infrastructure contract at startup.
    stage3_variant_heavy_default_cpus = null
    stage3_process_medium_default_cpus = null
    stage3_variant_heavy_memory_gb = null
    stage3_process_medium_memory_gb = null
    stage3_max_parallel_branches = null
    
    stage3_snv_caller = 'deepvariant'
    stage3_test_mode = false
    // Keep empty by default so governed references.yaml remains authoritative.
    // Optional emergency overrides can still be injected via --refs at runtime.
    refs = [:]
}

process {
    errorStrategy = 'finish'

    withLabel: 'process_low' {
        cpus = 4
        memory = 8.GB
        time = 2.h
    }

    withLabel: 'process_medium' {
        cpus = 4
        memory = 24.GB
        time = 6.h
    }

    withLabel: 'variant_heavy' {
        cpus = 8
        memory = 32.GB
        time = 12.h
        maxForks = 4
        maxRetries = 2
        errorStrategy = { task.exitStatus in [137, 140] ? 'retry' : 'finish' }
    }
}

docker.enabled = false
apptainer.enabled = false

profiles {
    dev_fast {
        process {
            withLabel: 'process_low' {
                cpus = 1
                memory = 2.GB
                time = 1.h
            }
            withLabel: 'process_medium' {
                cpus = 2
                memory = 4.GB
                time = 2.h
            }
            withLabel: 'variant_heavy' {
                cpus = 2
                memory = 4.GB
                time = 2.h
            }
        }
    }

    docker {
        docker {
            enabled = true
            runOptions = "-v \"${params.ref_dir}:/opt/reference:ro\" --rm"
        }
        workDir = params.work_root
        process {
            container = 'genvar-core:2.1.0'
        }
    }

    apptainer {
        apptainer {
            enabled = true
            autoMounts = true
        }
        workDir = params.work_root
        process {
            container = 'file://containers/wes-onco-core.sif'
        }
    }
}
