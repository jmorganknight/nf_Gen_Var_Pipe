params {
    samples = "${projectDir}/assets/samples_hg002_mini.yaml"
    input = null
    references = "${projectDir}/conf/references.yaml"
    thresholds = "${projectDir}/conf/thresholds.yaml"
    infrastructure = "${projectDir}/conf/infrastructure.yaml"
    outdir = 'results/master_orchestrator'
    ref_data_root = System.getenv('NXF_REF_DATA_ROOT') ?: '/media/jmk/Extreme Pro/WES_Onco_References'
    ref_dir = System.getenv('NXF_REF_DATA_ROOT') ?: '/media/jmk/Extreme Pro/WES_Onco_References'
    tmp_dir = '/scratch/tmp'
    work_root = '/scratch/nextflow_work'
    max_memory = 256.GB
    max_memory_gb = 256
    max_cpus = 32
    pki_key_dir = System.getenv('NXF_PKI_KEY_DIR') ?: "${projectDir}/keys"
    signer_key_path = null
    signer_pub_path = null
    banked_samplesheet_name = 'samples_hg002_banked_stage0.yaml'
    elprep_mem_gb = 140
    gomemlimit = '140GiB'
    gogc = '20'
    stage3_snv_indel_cpus = null
    stage3_cpus = null
    prs_min_backbone_coverage = 0.80
    refs = [
        cpic_allele_table: '/opt/reference/pgx/cpic',
        pharmvar_star_alleles: '/opt/reference/pgx/pharmvar',
        acmg_schema: '/opt/reference/clinical/acmg',
        mane_transcripts: '/opt/reference/beds/mane_select_v1.3.bed',
        cyp2d6_mask_bed: '/opt/reference/beds/paralog_homology_masks.bed',
        paralog_safe_regions: '/opt/reference/beds/paralog_homology_masks.bed',
        pgx_gene_panel: '/opt/reference/pgx/panel/pgx_gene_panel.yaml',
        gene_rule_set: '/opt/reference/pgx/rules/gene_rule_set.yaml',
        stage3_vcf_schema: "${projectDir}/Stage_3_Variant_Discovery_Engine/tests/schemas/v4.2_Production_Schema.json"
    ]
}

process {
    errorStrategy = { task.exitStatus in [137, 140, 7] ? 'retry' : 'finish' }
    maxRetries = 3
    memory = { 1.GB * Math.min(8 * task.attempt, params.max_memory_gb as int) }
    cpus = { Math.min(2 * task.attempt, params.max_cpus as int) }

    withLabel: 'process_low' {
        time = 4.h
    }

    withLabel: 'process_medium' {
        cpus = { Math.min(4 * task.attempt, params.max_cpus as int) }
        memory = { 1.GB * Math.min(16 * task.attempt, params.max_memory_gb as int) }
        time = 8.h
    }

    withLabel: 'process_high' {
        cpus = { Math.min(8 * task.attempt, params.max_cpus as int) }
        memory = { 1.GB * Math.min(32 * task.attempt, params.max_memory_gb as int) }
        time = 12.h
    }

    withLabel: 'process_high_memory' {
        cpus = { Math.min(8 * task.attempt, params.max_cpus as int) }
        memory = { 1.GB * Math.min(64 * task.attempt, params.max_memory_gb as int) }
        time = 16.h
    }
}

docker.enabled = false
apptainer.enabled = false

profiles {
    docker {
        docker {
            enabled = true
            runOptions = params.ref_dir
                ? "-v \"${params.ref_dir}:${params.ref_dir}:ro\" -v \"${params.ref_dir}:/opt/reference:ro\" -v \"${params.ref_dir}:/opt/refs:ro\" -v \"${params.tmp_dir}:/tmp\" --rm"
                : "-v \"${params.tmp_dir}:/tmp\" --rm"
        }
        workDir = params.work_root
    }

    apptainer {
        apptainer {
            enabled = true
            autoMounts = true
            runOptions = params.ref_dir
                ? "--bind ${params.ref_dir}:${params.ref_dir}:ro --bind ${params.ref_dir}:/opt/reference:ro --bind ${params.ref_dir}:/opt/refs:ro"
                : ''
        }
        workDir = params.work_root
    }

    dev_fast {
        process {
            withLabel: 'process_low' {
                cpus = { Math.min(1 * task.attempt, params.max_cpus as int) }
                memory = { 1.GB * Math.min(2 * task.attempt, params.max_memory_gb as int) }
                time = 30.m
            }
            withLabel: 'process_medium' {
                cpus = { Math.min(2 * task.attempt, params.max_cpus as int) }
                memory = { 1.GB * Math.min(4 * task.attempt, params.max_memory_gb as int) }
                time = 45.m
            }
            withLabel: 'process_high' {
                cpus = { Math.min(4 * task.attempt, params.max_cpus as int) }
                memory = { 1.GB * Math.min(8 * task.attempt, params.max_memory_gb as int) }
                time = 1.h
            }
            withLabel: 'process_high_memory' {
                cpus = { Math.min(4 * task.attempt, params.max_cpus as int) }
                memory = { 1.GB * Math.min(16 * task.attempt, params.max_memory_gb as int) }
                time = 90.m
            }
        }
    }
}
