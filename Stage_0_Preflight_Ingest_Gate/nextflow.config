params {
    samples = "${projectDir}/../assets/mini_control/samples_mini_control.yaml"
    input = null
    references = "${projectDir}/../control_plane/references.yaml"
    thresholds = "${projectDir}/../control_plane/thresholds.yaml"
    infrastructure = "${projectDir}/../control_plane/infrastructure.yaml"
    outdir = 'tests/fixtures/banked_stage0'
    tests_dir = 'tests'
    ref_data_root = System.getenv('NXF_REF_DATA_ROOT') ?: '/media/jmk/Extreme Pro/pipeline_references'
    ref_dir = System.getenv('NXF_REF_DATA_ROOT') ?: '/media/jmk/Extreme Pro/pipeline_references'
    tmp_dir = '/scratch/tmp'
    work_root = '/scratch/nextflow_work'
    pki_key_dir = System.getenv('NXF_PKI_KEY_DIR') ?: "${projectDir}/../keys"
    signer_key_path = null
    signer_pub_path = null
}

process {
    errorStrategy = { task.exitStatus in [137, 140, 7] ? 'retry' : 'finish' }
    maxRetries = 3

    withLabel: 'process_low' {
        cpus = { 2 * task.attempt }
        memory = { 4.GB * task.attempt }
        time = 4.h
    }

    withLabel: 'process_medium' {
        cpus = { 8 * task.attempt }
        memory = { 32.GB * task.attempt }
        time = 12.h
    }

    withLabel: 'process_high' {
        cpus = { 16 * task.attempt }
        memory = { 128.GB * task.attempt }
        time = 24.h
    }
}

docker.enabled = false
apptainer.enabled = false

profiles {
    docker {
        docker {
            enabled = true
            runOptions = params.ref_dir
                ? "-v \"${params.ref_dir}:/opt/reference:ro\" -v \"${params.tmp_dir}:/tmp\" --rm"
                : "-v \"${params.tmp_dir}:/tmp\" --rm"
        }
        workDir = params.work_root
        process {
            container = 'genvar-core:2.1.0'

            withLabel: 'process_low' {
                container = 'genvar-core:2.1.0'
            }

            withLabel: 'process_medium' {
                container = 'genvar-core:2.1.0'
            }

            withLabel: 'process_high' {
                container = 'genvar-core:2.1.0'
            }
        }
    }

    apptainer {
        apptainer {
            enabled = true
            autoMounts = true
        }
        workDir = params.work_root
        process {
            container = 'file://containers/genvar-core.sif'
        }
    }
}