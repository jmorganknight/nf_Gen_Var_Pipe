FROM ubuntu:22.04@sha256:281c5745f657873d78e5531fc5ba8575f46ab7769b94550ac99543f122679986

ENV DEBIAN_FRONTEND=noninteractive
ENV MAMBA_ROOT_PREFIX=/opt/micromamba
ENV PATH=/opt/conda/bin:/usr/local/bin:${PATH}

# 1. Install annotation and report-generation dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    wget \
    curl \
    git \
    bzip2 \
    ca-certificates \
    perl \
    python3 \
    python3-pip \
    python3-dev \
    zlib1g-dev \
    libbz2-dev \
    liblzma-dev \
    libcurl4-openssl-dev \
    libssl-dev \
    openjdk-17-jre-headless \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# 2. Annotation runtime binaries with direct PATH audit coverage.
RUN curl -Ls https://micro.mamba.pm/api/micromamba/linux-64/latest \
    | tar -xvj -C /usr/local/bin --strip-components=1 bin/micromamba && \
    micromamba create -y -p /opt/conda -c conda-forge -c bioconda \
      python=3.11 \
      bcftools \
      htslib \
      tabix \
      ensembl-vep \
      pypgx && \
    micromamba clean -a -y && \
    /opt/conda/bin/pip install --no-cache-dir --upgrade pip && \
    /opt/conda/bin/pip install --no-cache-dir \
    numpy \
    pandas \
    PyYAML \
    jinja2 \
    reportlab \
    cryptography

# 3. Install the governed PharmCAT JAR supplied by the build pipeline.
COPY vendor/pharmcat.jar /opt/vendor/pharmcat.jar

RUN chmod 0644 /opt/vendor/pharmcat.jar && \
    unzip -tq /opt/vendor/pharmcat.jar >/dev/null && \
    printf '#!/usr/bin/env bash\nexec java -jar /opt/vendor/pharmcat.jar "$@"\n' > /usr/local/bin/pharmcat && \
    chmod +x /usr/local/bin/pharmcat

# 4. Verification check
RUN command -v bcftools && \
    command -v vep && \
    command -v pypgx && \
    command -v pharmcat && \
    unzip -tq /opt/vendor/pharmcat.jar >/dev/null && \
    /opt/conda/bin/python - <<'PY'
import json
from pathlib import Path

audit = {
    'image': 'genvar-annotation:2.1.0',
    'implemented_binaries': ['bcftools', 'vep', 'pypgx', 'pharmcat'],
}
Path('/opt/container_binary_audit.annotation.json').write_text(json.dumps(audit, indent=2) + '\n', encoding='utf-8')
print('genvar-annotation:2.1.0 audit emitted')
PY

WORKDIR /workspace
