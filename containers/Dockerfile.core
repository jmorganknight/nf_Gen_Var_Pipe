FROM ubuntu:22.04@sha256:281c5745f657873d78e5531fc5ba8575f46ab7769b94550ac99543f122679986

ENV DEBIAN_FRONTEND=noninteractive
ENV MAMBA_ROOT_PREFIX=/opt/micromamba
ENV PATH=/opt/conda/bin:/usr/local/bin:${PATH}

# 1. System dependencies and core bioinformatics tools via apt
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    wget \
    curl \
    git \
    bzip2 \
    ca-certificates \
    gnupg \
    python3 \
    python3-pip \
    python3-dev \
    zlib1g-dev \
    libbz2-dev \
    liblzma-dev \
    libcurl4-openssl-dev \
    libssl-dev \
    openjdk-17-jre-headless \
    perl \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# 2. Micromamba-managed clinical toolchain coverage for direct PATH availability.
RUN curl -Ls https://micro.mamba.pm/api/micromamba/linux-64/latest \
    | tar -xvj -C /usr/local/bin --strip-components=1 bin/micromamba && \
    micromamba create -y -p /opt/conda -c conda-forge -c bioconda \
            python=3.10 \
      bcftools \
      samtools \
      htslib \
      bedtools \
      bwa-mem2 \
      minimap2 \
      fastp \
      verifybamid2 \
    cnvkit=0.9.10 \
            mosdepth \
      whatshap \
      shapeit5 \
      ensembl-vep \
      pypgx \
      gatk4 && \
        micromamba create -y -p /opt/conda-py2 -c conda-forge python=2.7 && \
        ln -sf /opt/conda-py2/bin/python /usr/local/bin/python2 && \
    micromamba clean -a -y

# 3. Python support packages plus auxiliary clinical wrappers.
RUN /opt/conda/bin/pip install --no-cache-dir --upgrade pip && \
    /opt/conda/bin/pip install --no-cache-dir \
      numpy \
      pandas \
      scipy \
      biopython \
      PyYAML \
    cryptography && \
    printf '#!/usr/bin/env bash\nexec /opt/conda/bin/gatk Mutect2 "$@"\n' > /usr/local/bin/Mutect2 && \
    printf '#!/usr/bin/env bash\nif command -v VerifyBamID >/dev/null 2>&1; then exec VerifyBamID "$@"; fi\nexec /opt/conda/bin/VerifyBamID "$@"\n' > /usr/local/bin/VerifyBamID2 && \
    printf '#!/usr/bin/env bash\nif command -v configureStrelkaGermlineWorkflow.py >/dev/null 2>&1; then exec configureStrelkaGermlineWorkflow.py "$@"; fi\nif command -v strelka >/dev/null 2>&1; then exec strelka "$@"; fi\necho "Strelka2 wrapper could not locate an installed Strelka entrypoint" >&2\nexit 127\n' > /usr/local/bin/Strelka2 && \
    printf '#!/usr/bin/env bash\nif command -v phase_common >/dev/null 2>&1; then exec phase_common "$@"; fi\necho "shapeit5 wrapper could not locate phase_common executable" >&2\nexit 127\n' > /usr/local/bin/shapeit5 && \
    chmod +x /usr/local/bin/Mutect2 /usr/local/bin/VerifyBamID2 /usr/local/bin/Strelka2 /usr/local/bin/shapeit5

# 4. Install the governed elPrep binary supplied by the build pipeline.
COPY vendor/elprep /usr/local/bin/elprep

RUN chmod 0755 /usr/local/bin/elprep && \
    if ! /usr/local/bin/elprep --help >/tmp/elprep.help 2>&1 && ! /usr/local/bin/elprep version >/tmp/elprep.version 2>&1; then \
        echo "BUILD_VALIDATION_FAILURE: supplied elprep binary is not executable" >&2; \
        exit 64; \
    fi

# 5. Manta and Strelka binaries from official Illumina release tarballs.
RUN wget -q https://github.com/Illumina/manta/releases/download/v1.6.0/manta-1.6.0.centos6_x86_64.tar.bz2 && \
    tar -xjf manta-1.6.0.centos6_x86_64.tar.bz2 && \
    ln -sf /manta-1.6.0.centos6_x86_64/bin/configManta.py /usr/local/bin/configManta.py && \
    rm -f manta-1.6.0.centos6_x86_64.tar.bz2 && \
    wget -q https://github.com/Illumina/strelka/releases/download/v2.9.10/strelka-2.9.10.centos6_x86_64.tar.bz2 && \
    tar -xjf strelka-2.9.10.centos6_x86_64.tar.bz2 && \
    ln -sf /strelka-2.9.10.centos6_x86_64/bin/configureStrelkaGermlineWorkflow.py /usr/local/bin/configureStrelkaGermlineWorkflow.py && \
    ln -sf /strelka-2.9.10.centos6_x86_64/bin/configureStrelkaSomaticWorkflow.py /usr/local/bin/configureStrelkaSomaticWorkflow.py && \
    rm -f strelka-2.9.10.centos6_x86_64.tar.bz2

# 6. ExpansionHunter v5.0.0 binary for STR expansion branch
RUN wget https://github.com/Illumina/ExpansionHunter/releases/download/v5.0.0/ExpansionHunter-v5.0.0-linux_x86_64.tar.gz \
    && tar -zxvf ExpansionHunter-v5.0.0-linux_x86_64.tar.gz \
    && mv ExpansionHunter-v5.0.0-linux_x86_64/bin/ExpansionHunter /usr/local/bin/ \
    && rm -rf ExpansionHunter-v5.0.0-*

# 7. Capability verification and audit coverage for workflow-called binaries.
RUN command -v bwa-mem2 && \
    command -v minimap2 && \
    command -v samtools && \
    command -v bcftools && \
    command -v elprep && \
    command -v fastp && \
    command -v VerifyBamID2 && \
    command -v Mutect2 && \
    command -v Strelka2 && \
    command -v configManta.py && \
    command -v mosdepth && \
    command -v whatshap && \
    command -v shapeit5 && \
    command -v vep && \
    command -v pypgx && \
    command -v ExpansionHunter && \
    /opt/conda/bin/python - <<'PY'
import json
from pathlib import Path

audit = {
    'image': 'genvar-core:2.1.0',
    'implemented_binaries': [
        'bwa-mem2', 'minimap2', 'samtools', 'bcftools', 'fastp',
        'VerifyBamID2', 'Mutect2', 'Strelka2', 'whatshap', 'shapeit5',
        'vep', 'pypgx', 'ExpansionHunter', 'configManta.py', 'mosdepth'
    ],
}
Path('/opt/container_binary_audit.core.json').write_text(json.dumps(audit, indent=2) + '\n', encoding='utf-8')
print('genvar-core:2.1.0 audit emitted')
PY

WORKDIR /workspace
