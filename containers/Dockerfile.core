FROM ubuntu:22.04@sha256:281c5745f657873d78e5531fc5ba8575f46ab7769b94550ac99543f122679986

ARG REQUIRE_FULL_CLINICAL_BINARIES=0

ENV DEBIAN_FRONTEND=noninteractive
ENV MAMBA_ROOT_PREFIX=/opt/micromamba
ENV PATH=/opt/conda/bin:/usr/local/bin:${PATH}
ENV ELPREP_PLACEHOLDER=1
ENV PHARMCAT_PLACEHOLDER=1

# 1. System dependencies and core bioinformatics tools via apt
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    wget \
    curl \
    git \
    bzip2 \
    ca-certificates \
    gnupg \
    python3 \
    python3-pip \
    python3-dev \
    zlib1g-dev \
    libbz2-dev \
    liblzma-dev \
    libcurl4-openssl-dev \
    libssl-dev \
    openjdk-17-jre-headless \
    perl \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# 2. Micromamba-managed clinical toolchain coverage for direct PATH availability.
RUN curl -Ls https://micro.mamba.pm/api/micromamba/linux-64/latest \
    | tar -xvj -C /usr/local/bin --strip-components=1 bin/micromamba && \
    micromamba create -y -p /opt/conda -c conda-forge -c bioconda \
      python=3.11 \
      bcftools \
      samtools \
      htslib \
      bedtools \
      bwa-mem2 \
      minimap2 \
      fastp \
      verifybamid2 \
      cnvkit=0.9.10 \
      whatshap \
      shapeit5 \
      ensembl-vep \
      pypgx \
      strelka \
      gatk4 && \
    micromamba clean -a -y

# 3. Python support packages plus auxiliary clinical wrappers.
RUN /opt/conda/bin/pip install --no-cache-dir --upgrade pip && \
    /opt/conda/bin/pip install --no-cache-dir \
      numpy \
      pandas \
      scipy \
      biopython \
      PyYAML \
      cryptography && \
    printf '#!/usr/bin/env bash\nexec /opt/conda/bin/gatk Mutect2 "$@"\n' > /usr/local/bin/Mutect2 && \
    printf '#!/usr/bin/env bash\nif command -v VerifyBamID >/dev/null 2>&1; then exec VerifyBamID "$@"; fi\nexec /opt/conda/bin/VerifyBamID "$@"\n' > /usr/local/bin/VerifyBamID2 && \
    printf '#!/usr/bin/env bash\nif command -v configureStrelkaGermlineWorkflow.py >/dev/null 2>&1; then exec configureStrelkaGermlineWorkflow.py "$@"; fi\nif command -v strelka >/dev/null 2>&1; then exec strelka "$@"; fi\necho "Strelka2 wrapper could not locate an installed Strelka entrypoint" >&2\nexit 127\n' > /usr/local/bin/Strelka2 && \
    printf '#!/usr/bin/env bash\nif [[ "${ELPREP_PLACEHOLDER:-1}" == "1" ]]; then\n  echo "CONTAINER_BINARY_VALIDATION_FAILURE: elprep placeholder wrapper detected; install licensed elprep binary before production alignment" >&2\n  exit 127\nfi\necho "CONTAINER_BINARY_VALIDATION_FAILURE: elprep invocation failed and no validated binary was available" >&2\nexit 127\n' > /usr/local/bin/elprep && \
    printf '#!/usr/bin/env bash\nif [[ "${PHARMCAT_PLACEHOLDER:-1}" == "1" ]]; then\n  echo "CONTAINER_BINARY_VALIDATION_FAILURE: pharmcat placeholder wrapper detected; install PharmCAT CLI/JAR before production PGx reporting" >&2\n  exit 127\nfi\necho "CONTAINER_BINARY_VALIDATION_FAILURE: pharmcat invocation failed and no validated binary was available" >&2\nexit 127\n' > /usr/local/bin/pharmcat && \
    chmod +x /usr/local/bin/Mutect2 /usr/local/bin/VerifyBamID2 /usr/local/bin/Strelka2 /usr/local/bin/elprep /usr/local/bin/pharmcat

# 4. ExpansionHunter v5.0.0 binary for STR expansion branch
RUN wget https://github.com/Illumina/ExpansionHunter/releases/download/v5.0.0/ExpansionHunter-v5.0.0-linux_x86_64.tar.gz \
    && tar -zxvf ExpansionHunter-v5.0.0-linux_x86_64.tar.gz \
    && mv ExpansionHunter-v5.0.0-linux_x86_64/bin/ExpansionHunter /usr/local/bin/ \
    && rm -rf ExpansionHunter-v5.0.0-*

# 5. Capability verification and audit coverage for workflow-called binaries.
RUN command -v bwa-mem2 && \
    command -v minimap2 && \
    command -v samtools && \
    command -v bcftools && \
    command -v elprep && \
    command -v fastp && \
    command -v VerifyBamID2 && \
    command -v Mutect2 && \
    command -v Strelka2 && \
    command -v whatshap && \
    command -v shapeit5 && \
    command -v vep && \
    command -v pypgx && \
    command -v pharmcat && \
    test "${ELPREP_PLACEHOLDER}" = "1" && \
    test "${PHARMCAT_PLACEHOLDER}" = "1" && \
    command -v ExpansionHunter && \
    /opt/conda/bin/python - <<'PY'
import json
from pathlib import Path

audit = {
    'image': 'wes-onco-core:1.0.0',
    'implemented_binaries': [
        'bwa-mem2', 'minimap2', 'samtools', 'bcftools', 'fastp',
        'VerifyBamID2', 'Mutect2', 'Strelka2', 'whatshap', 'shapeit5',
        'vep', 'pypgx', 'ExpansionHunter'
    ],
    'placeholder_binaries': {
        'elprep': 'requires separately supplied licensed/runtime binary',
        'pharmcat': 'requires separately supplied PharmCAT CLI or jar',
    },
}
Path('/opt/container_binary_audit.core.json').write_text(json.dumps(audit, indent=2) + '\n', encoding='utf-8')
print('wes-onco-core:1.0.0 audit emitted with placeholder exceptions for elprep and pharmcat')
PY

RUN if [ "${REQUIRE_FULL_CLINICAL_BINARIES}" = "1" ] && ([ "${ELPREP_PLACEHOLDER}" = "1" ] || [ "${PHARMCAT_PLACEHOLDER}" = "1" ]); then \
            echo "BUILD_VALIDATION_FAILURE: REQUIRE_FULL_CLINICAL_BINARIES=1 but placeholder elprep/pharmcat wrappers are still configured" >&2; \
            exit 64; \
        fi

WORKDIR /workspace
