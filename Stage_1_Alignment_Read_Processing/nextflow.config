params {
    samples = 'samplesheet.yaml'
    input = null
    references = 'references.yaml'
    thresholds = 'thresholds.yaml'
    outdir = 'tests/fixtures/banked_stage1'
    ref_dir = '/media/jmk/Extreme Pro/WES_Onco_References'
    tmp_dir = '/scratch/tmp'
    work_root = '/scratch/nextflow_work'
    max_cpus = 30
    elprep_mem_gb = 140
    gomemlimit = '140GiB'
    gogc = '20'
}

process {
    errorStrategy = { task.exitStatus in [137, 140, 7] ? 'retry' : 'finish' }
    maxRetries = 2

    withLabel: 'process_low' {
        cpus = { Math.min(4, 2 * task.attempt) }
        memory = { 4.GB * task.attempt }
        time = 4.h
    }

    withLabel: 'process_high' {
        cpus = { Math.min((params.max_cpus ?: 30) as int, 16 * task.attempt) }
        memory = { 256.GB * task.attempt }
        time = 24.h
    }
}

docker.enabled = false
apptainer.enabled = false

profiles {
    docker {
        docker {
            enabled = true
            runOptions = "-v \"${params.ref_dir}:/opt/reference:ro\" -v \"${params.tmp_dir}:/tmp\" --rm"
        }
        workDir = params.work_root
        process {
            container = 'wes-onco-core:1.0.0'
        }
    }

    apptainer {
        apptainer {
            enabled = true
            autoMounts = true
        }
        workDir = params.work_root
        process {
            container = 'file://containers/wes-onco-core.sif'
        }
    }
}
