params {
    samples = "${projectDir}/../assets/mini_control/samples_mini_control.yaml"
    input = null
    references = "${projectDir}/../control_plane/references.yaml"
    thresholds = "${projectDir}/../control_plane/thresholds.yaml"
    infrastructure = "${projectDir}/../control_plane/infrastructure.yaml"
    outdir = 'tests/banked_stage1'
    ref_data_root = System.getenv('NXF_REF_DATA_ROOT') ?: '/media/jmk/Extreme Pro/pipeline_references'
    ref_dir = System.getenv('NXF_REF_DATA_ROOT') ?: '/media/jmk/Extreme Pro/pipeline_references'
    tmp_dir = '/scratch/tmp'
    work_root = '/scratch/nextflow_work'
    max_cpus = 30
    elprep_mem_gb = 140
    gomemlimit = '140GiB'
    gogc = '20'
    refs = [
        reference_genome: null,
        reference_fai: null,
        reference_dict: null,
        bwa_index_base: null,
        bwa_index: null,
        fasta: null,
        fai: null,
        dict: null
    ]
}

process {
    errorStrategy = { task.exitStatus in [137, 140, 7] ? 'retry' : 'finish' }
    maxRetries = 2

    withLabel: 'process_low' {
        cpus = { Math.min(4, 2 * task.attempt) }
        memory = { 4.GB * task.attempt }
        time = 4.h
    }

    withLabel: 'process_high' {
        cpus = {
            def cap = 30
            if (params.max_cpus) {
                cap = Integer.parseInt("${params.max_cpus}")
            }
            Math.min(cap, 16 * (task.attempt ?: 1))
        }
        memory = { 256.GB * task.attempt }
        time = 24.h
    }
}

docker.enabled = false
apptainer.enabled = false

profiles {
    dev_fast {
        process {
            withLabel: 'process_low' {
                cpus = 1
                memory = 2.GB
                time = 1.h
            }
            withLabel: 'process_high' {
                cpus = 2
                memory = 4.GB
                time = 2.h
            }
        }
    }

    docker {
        docker {
            enabled = true
            runOptions = "-v \"${params.ref_dir}:/opt/reference:ro\" -v \"${params.tmp_dir}:/tmp\" --rm"
        }
        workDir = params.work_root
        process {
            container = 'wes-onco-core:1.0.0'
        }
    }

    apptainer {
        apptainer {
            enabled = true
            autoMounts = true
        }
        workDir = params.work_root
        process {
            container = 'file://containers/wes-onco-core.sif'
        }
    }
}
