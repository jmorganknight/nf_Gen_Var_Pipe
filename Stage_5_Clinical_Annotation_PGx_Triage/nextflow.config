params {
    samples = "${projectDir}/tests/samples_annotation_pgx.yaml"
    input = null
    references = "${projectDir}/../control_plane/references.yaml"
    thresholds = "${projectDir}/../control_plane/thresholds.yaml"
    infrastructure = "${projectDir}/../control_plane/infrastructure.yaml"
    outdir = 'tests/stage5'
    stage5_outdir = "${params.outdir}/Stage_5"
    ref_data_root = params.ref_data_root ?: params.ref_dir ?: System.getenv('NXF_REF_DATA_ROOT') ?: ((((params.references ?: '').toString().trim()) && new File((params.references ?: '').toString()).exists()) ? ((new groovy.yaml.YamlSlurper().parse(new File((params.references ?: '').toString()))?.ref_data_root ?: '').toString().trim()) : '')
    ref_dir = params.ref_dir ?: params.ref_data_root ?: System.getenv('NXF_REF_DATA_ROOT') ?: ((((params.references ?: '').toString().trim()) && new File((params.references ?: '').toString()).exists()) ? ((new groovy.yaml.YamlSlurper().parse(new File((params.references ?: '').toString()))?.ref_data_root ?: '').toString().trim()) : '')
    reference_mount_root = params.ref_dir ?: params.ref_data_root ?: System.getenv('NXF_REF_DATA_ROOT') ?: ((((params.references ?: '').toString().trim()) && new File((params.references ?: '').toString()).exists()) ? ((new groovy.yaml.YamlSlurper().parse(new File((params.references ?: '').toString()))?.ref_data_root ?: '').toString().trim()) : '')
    tmp_dir = null
    work_root = null
    pki_key_dir = 'keys'
    signer_key_path = null
    signer_pub_path = null
    signer_scope = null
    signer_id = null
    allow_bootstrap_for_production_run = null
    max_cpus = 30
    prs_min_backbone_coverage = 0.80
    enable_prs_branch = true
    enable_sf_branch = true
    refs = [
        revel: "${params.ref_dir}/models/revel_GRCh38_v1.7.tsv.gz",
        alphamissense: "${params.ref_dir}/models/revel_GRCh38_v1.7.tsv.gz",
        cadd: "${params.ref_dir}/models/CADD_GRCh38_v1.7.tsv.gz",
        spliceai: "${params.ref_dir}/models/revel_GRCh38_v1.7.tsv.gz",
        clinvar: "${params.ref_dir}/clinvar/clinvar_20260601.vcf.gz",
        gnomad: "${params.ref_dir}/clinvar/gnomad.v4.0.genomes.vcf.gz",
        pfam_domains: "${params.ref_dir}/beds/mane_select_v1.3.bed",
        alphafold_annotations: "${params.ref_dir}/beds/mane_select_v1.3.bed",
        litvar: null,
        pmc: null,
        mastermind: null,
        pgx_cli_script: "${projectDir}/bin/pgx_cli.py",
        cpic_allele_table: "${params.ref_dir}/pgx/cpic",
        pharmvar_star_alleles: "${params.ref_dir}/pgx/pharmvar",
        acmg_schema: "${params.ref_dir}/clinical/acmg",
        mane_transcripts: "${params.ref_dir}/beds/mane_select_v1.3.bed",
        cyp2d6_mask_bed: "${params.ref_dir}/beds/paralog_homology_masks.bed",
        paralog_safe_regions: "${params.ref_dir}/beds/paralog_homology_masks.bed",
        pgx_gene_panel: "${params.ref_dir}/pgx/panel/pgx_gene_panel.yaml",
        gene_rule_set: "${params.ref_dir}/pgx/rules/gene_rule_set.yaml"
    ]
}

process {
    errorStrategy = { task.exitStatus in [137, 140, 7] ? 'retry' : 'finish' }
    maxRetries = 2

    withLabel: 'process_low' {
        cpus = { Math.min(4, (2 * task.attempt) as int) }
        memory = { 4.GB * task.attempt }
        time = 4.h
    }

    withLabel: 'process_medium' {
        cpus = { Math.min(8, (4 * task.attempt) as int) }
        memory = { 8.GB * task.attempt }
        time = 6.h
    }

    withLabel: 'process_high' {
        cpus = { Math.min(30, (16 * task.attempt) as int) }
        memory = { 64.GB * task.attempt }
        time = 12.h
    }
}

docker.enabled = false
apptainer.enabled = false
singularity.enabled = false

profiles {
    test {
        params {
            input = "${projectDir}/tests/inputs/hg002_stub/stub_input/samples_stage4_stub.yaml"
            outdir = "${projectDir}/tests/inputs/hg002_stub/stub_output"
            enable_prs_branch = false
            enable_sf_branch = false
            refs = [
                revel: "${projectDir}/tests/inputs/hg002_stub/stub_assets/revel.tsv",
                alphamissense: "${projectDir}/tests/inputs/hg002_stub/stub_assets/alphamissense.tsv",
                cadd: "${projectDir}/tests/inputs/hg002_stub/stub_assets/cadd.tsv",
                spliceai: "${projectDir}/tests/inputs/hg002_stub/stub_assets/spliceai.tsv",
                clinvar: "${projectDir}/tests/inputs/hg002_stub/stub_assets/clinvar.tsv",
                gnomad: "${projectDir}/tests/inputs/hg002_stub/stub_assets/gnomad.tsv",
                pfam_domains: "${projectDir}/tests/inputs/hg002_stub/stub_assets/pfam_domains.tsv",
                alphafold_annotations: "${projectDir}/tests/inputs/hg002_stub/stub_assets/alphafold_annotations.tsv",
                litvar: "${projectDir}/tests/inputs/hg002_stub/stub_assets/litvar.txt",
                pmc: "${projectDir}/tests/inputs/hg002_stub/stub_assets/pmc.txt",
                mastermind: "${projectDir}/tests/inputs/hg002_stub/stub_assets/mastermind.txt",
                pgx_cli_script: "${projectDir}/bin/pgx_cli.py",
                cpic_allele_table: "${projectDir}/tests/inputs/hg002_stub/stub_assets/gene_rule_set.tsv",
                pharmvar_star_alleles: "${projectDir}/tests/inputs/hg002_stub/stub_assets/gene_rule_set.tsv",
                acmg_schema: "${projectDir}/tests/inputs/hg002_stub/stub_assets/acmg_schema.tsv",
                mane_transcripts: "${projectDir}/tests/inputs/hg002_stub/stub_assets/pgx_gene_panel.tsv",
                cyp2d6_mask_bed: "${projectDir}/tests/inputs/hg002_stub/stub_assets/pgx_gene_panel.tsv",
                paralog_safe_regions: "${projectDir}/tests/inputs/hg002_stub/stub_assets/pgx_gene_panel.tsv",
                pgx_gene_panel: "${projectDir}/tests/inputs/hg002_stub/stub_assets/pgx_gene_panel.tsv",
                gene_rule_set: "${projectDir}/tests/inputs/hg002_stub/stub_assets/gene_rule_set.tsv"
            ]
        }
    }

    docker {
        docker {
            enabled = true
            runOptions = params.reference_mount_root
                ? "-v \"${params.reference_mount_root}:${params.reference_mount_root}:ro\" --rm"
                : '--rm'
        }
        workDir = params.work_root
        process {
            container = 'genvar-annotation:2.1.0'
        }
    }

    apptainer {
        apptainer {
            enabled = true
            autoMounts = true
            runOptions = params.reference_mount_root
                ? "--bind \"${params.reference_mount_root}:${params.reference_mount_root}:ro\""
                : ''
        }
        workDir = params.work_root
        process {
            container = 'file://containers/genvar-annotation.sif'
        }
    }

    singularity {
        singularity {
            enabled = true
            autoMounts = true
            runOptions = params.reference_mount_root
                ? "--bind \"${params.reference_mount_root}:${params.reference_mount_root}:ro\""
                : ''
        }
        workDir = params.work_root
        process {
            container = 'file://containers/genvar-annotation.sif'
        }
    }
}
