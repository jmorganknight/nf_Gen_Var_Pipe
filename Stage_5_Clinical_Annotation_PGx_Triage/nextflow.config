params {
    samples = "${projectDir}/tests/samples_annotation_pgx.yaml"
    input = null
    references = "${projectDir}/../conf/references.yaml"
    thresholds = "${projectDir}/../conf/thresholds.yaml"
    infrastructure = "${projectDir}/../conf/infrastructure.yaml"
    outdir = 'tests/fixtures/banked_stage5'
    ref_data_root = System.getenv('NXF_REF_DATA_ROOT') ?: '/media/jmk/Extreme Pro/WES_Onco_References'
    ref_dir = System.getenv('NXF_REF_DATA_ROOT') ?: '/media/jmk/Extreme Pro/WES_Onco_References'
    tmp_dir = null
    work_root = null
    max_cpus = 30
    prs_min_backbone_coverage = 0.80
    enable_prs_branch = true
    enable_sf_branch = true
    refs = [
        revel: null,
        alphamissense: null,
        cadd: null,
        spliceai: null,
        clinvar: null,
        gnomad: null,
        pfam_domains: null,
        alphafold_annotations: null,
        litvar: null,
        pmc: null,
        mastermind: null,
        pgx_cli_script: "${projectDir}/bin/pgx_cli.py",
        cpic_allele_table: null,
        pharmvar_star_alleles: null,
        acmg_schema: null,
        mane_transcripts: null,
        cyp2d6_mask_bed: null,
        paralog_safe_regions: null,
        pgx_gene_panel: null,
        gene_rule_set: null
    ]
}

process {
    errorStrategy = { task.exitStatus in [137, 140, 7] ? 'retry' : 'finish' }
    maxRetries = 2

    withLabel: 'process_low' {
        cpus = { Math.min(4, (2 * task.attempt) as int) }
        memory = { 4.GB * task.attempt }
        time = 4.h
    }

    withLabel: 'process_medium' {
        cpus = { Math.min(8, (4 * task.attempt) as int) }
        memory = { 8.GB * task.attempt }
        time = 6.h
    }

    withLabel: 'process_high' {
        cpus = { Math.min(30, (16 * task.attempt) as int) }
        memory = { 64.GB * task.attempt }
        time = 12.h
    }
}

docker.enabled = false
apptainer.enabled = false

profiles {
    test {
        params {
            input = "${projectDir}/tests/fixtures/stub_input/samples_hg002_banked_stage4_stub.yaml"
            outdir = "${projectDir}/tests/fixtures/stub_output"
            enable_prs_branch = false
            enable_sf_branch = false
            refs = [
                revel: "${projectDir}/tests/fixtures/stub_assets/revel.tsv",
                alphamissense: "${projectDir}/tests/fixtures/stub_assets/alphamissense.tsv",
                cadd: "${projectDir}/tests/fixtures/stub_assets/cadd.tsv",
                spliceai: "${projectDir}/tests/fixtures/stub_assets/spliceai.tsv",
                clinvar: "${projectDir}/tests/fixtures/stub_assets/clinvar.tsv",
                gnomad: "${projectDir}/tests/fixtures/stub_assets/gnomad.tsv",
                pfam_domains: "${projectDir}/tests/fixtures/stub_assets/pfam_domains.tsv",
                alphafold_annotations: "${projectDir}/tests/fixtures/stub_assets/alphafold_annotations.tsv",
                litvar: "${projectDir}/tests/fixtures/stub_assets/litvar.txt",
                pmc: "${projectDir}/tests/fixtures/stub_assets/pmc.txt",
                mastermind: "${projectDir}/tests/fixtures/stub_assets/mastermind.txt",
                pgx_cli_script: "${projectDir}/bin/pgx_cli.py",
                cpic_allele_table: "${projectDir}/tests/fixtures/stub_assets/gene_rule_set.tsv",
                pharmvar_star_alleles: "${projectDir}/tests/fixtures/stub_assets/gene_rule_set.tsv",
                acmg_schema: "${projectDir}/tests/fixtures/stub_assets/acmg_schema.tsv",
                mane_transcripts: "${projectDir}/tests/fixtures/stub_assets/pgx_gene_panel.tsv",
                cyp2d6_mask_bed: "${projectDir}/tests/fixtures/stub_assets/pgx_gene_panel.tsv",
                paralog_safe_regions: "${projectDir}/tests/fixtures/stub_assets/pgx_gene_panel.tsv",
                pgx_gene_panel: "${projectDir}/tests/fixtures/stub_assets/pgx_gene_panel.tsv",
                gene_rule_set: "${projectDir}/tests/fixtures/stub_assets/gene_rule_set.tsv"
            ]
        }
    }

    docker {
        docker {
            enabled = true
            runOptions = '--rm'
        }
        workDir = params.work_root
        process {
            container = 'wes-onco-core:1.0.0'
        }
    }

    apptainer {
        apptainer {
            enabled = true
            autoMounts = true
        }
        workDir = params.work_root
        process {
            container = 'file://containers/wes-onco-core.sif'
        }
    }
}
