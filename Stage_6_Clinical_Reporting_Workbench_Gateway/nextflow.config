params {
    samples = "${projectDir}/../conf/samples/samples_mini_control_banked_stage5.yaml"
    input = null
    references = "${projectDir}/../control_plane/references.yaml"
    thresholds = "${projectDir}/../control_plane/thresholds.yaml"
    infrastructure = "${projectDir}/../control_plane/infrastructure.yaml"
    refs = [:]
    outdir = 'tests/fixtures/banked_stage6'
    ref_data_root = System.getenv('NXF_REF_DATA_ROOT') ?: '/media/jmk/Extreme Pro/pipeline_references'
    ref_dir = System.getenv('NXF_REF_DATA_ROOT') ?: '/media/jmk/Extreme Pro/pipeline_references'
    tmp_dir = '/scratch/tmp'
    work_root = '/scratch/nextflow_work'
    max_cpus = 30
}

process {
    errorStrategy = { task.exitStatus in [137, 140, 7] ? 'retry' : 'finish' }
    maxRetries = 2

    withLabel: 'process_low' {
        cpus = { Math.min(4, (2 * task.attempt) as int) }
        memory = { 4.GB * task.attempt }
        time = 4.h
    }

    withLabel: 'process_medium' {
        cpus = { Math.min(8, (4 * task.attempt) as int) }
        memory = { 8.GB * task.attempt }
        time = 6.h
    }

    withLabel: 'process_high' {
        cpus = { Math.min(30, (16 * task.attempt) as int) }
        memory = { 64.GB * task.attempt }
        time = 12.h
    }
}

docker.enabled = false
apptainer.enabled = false

profiles {
    docker {
        docker {
            enabled = true
            runOptions = "-v \"${params.ref_dir}:/opt/reference:ro\" -v \"${params.tmp_dir}:/tmp\" --rm"
        }
        workDir = params.work_root
        process {
            container = 'genvar-reporting:2.1.0'
        }
    }

    apptainer {
        apptainer {
            enabled = true
            autoMounts = true
        }
        workDir = params.work_root
        process {
            container = 'file://containers/genvar-reporting.sif'
        }
    }
}
